# ALab local environment example.
# Copy values into your shell or local .env tooling as needed.
# Do not put real root/admin keys, experiment tokens, or secret_env values in this file.

# Optional ALab home override. Leave empty to use ~/.ALab.
ALAB_HOME=

# Optional ambient admin/root key for commands that already expose an admin/root surface.
# Help and public/token surfaces intentionally ignore this for capability expansion.
ALAB_KEY=

# Set to 1 to show internal debug tracebacks for system failures.
ALAB_DEBUG=

# Keep uv dependency/cache state local to the checkout when desired.
UV_CACHE_DIR=.uv-cache

# Use the official Python package index for commands that need dependency downloads.
UV_DEFAULT_INDEX=https://pypi.org/simple

# Fallback for running from an existing Python environment without installing the package.
PYTHONPATH=src

# Opt-in real Docker integration tests.
ALAB_RUN_REAL_DOCKER=

# Opt-in SkyDiscover Python evaluator dependency tests.
ALAB_RUN_REAL_SKYDISCOVER_PYTHON=
ALAB_RUN_NETWORKED_SKYDISCOVER_PYTHON=
ALAB_RUN_NATIVE_SKYDISCOVER_PYTHON=
ALAB_NATIVE_SKYDISCOVER_PYTHON_REQUIREMENT=
ALAB_NATIVE_SKYDISCOVER_PYTHON_MODULE=

# Opt-in live SkyDiscover catalog tests.
ALAB_RUN_LIVE_SKYDISCOVER_CATALOG=
